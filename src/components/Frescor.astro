---
interface Props { revisadoEm: Date; }
const { revisadoEm } = Astro.props;
const agora = new Date();
const meses = Math.max(0, (agora.getFullYear() - revisadoEm.getFullYear()) * 12 + agora.getMonth() - revisadoEm.getMonth());
const alerta = meses > 6;
---
<span class:list={['inline-flex items-center gap-2 rounded-md border px-3 py-1 text-sm', alerta ? 'border-amber-300 bg-amber-50 text-amber-900' : 'border-teal-300 bg-teal-50 text-teal-900']} title={alerta ? 'Esta informação pode precisar de uma nova revisão.' : 'Esta informação foi revisada recentemente.'}>
  {alerta && <span aria-hidden="true">⚠</span>}
  Revisado há {meses} {meses === 1 ? 'mês' : 'meses'}
</span>
